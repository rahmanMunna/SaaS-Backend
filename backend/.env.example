# Copy this file to .env and change the secrets:  cp .env.example .env
# docker compose reads .env automatically (same folder as docker-compose.yml).

# ---------- API ----------
NODE_ENV=development
PORT=3000
API_HOST_PORT=3000

# ---------- PostgreSQL ----------
DB_USER=saas
DB_PASSWORD=change-me-postgres
DB_NAME=saas
DB_HOST_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=change-me-redis
REDIS_HOST_PORT=6379

# ---------- MinIO (S3-compatible storage) ----------
# Use URL-safe characters only (letters, digits, - _) - they are embedded in a URL.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=uploads
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------- Mailpit (local email catcher) ----------
MAILPIT_UI_HOST_PORT=8025
